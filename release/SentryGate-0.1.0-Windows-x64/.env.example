SENTRYGATE_PORT=4300
SENTRYGATE_HOST=127.0.0.1
# Dashboard/API is loopback-only unless this is explicitly enabled with TLS and authenticated accounts.
SENTRYGATE_REMOTE_ACCESS_ENABLED=false
SENTRYGATE_GATEWAY_PORT=4310
SENTRYGATE_GATEWAY_HOST=127.0.0.1
# Local-only data directory (SQLite database, reports and operational state).
# Relative paths resolve from the repository root. SENTRYGATE_DB_PATH overrides the database filename/location.
# Leave blank for the development default; the PowerShell launcher uses %LOCALAPPDATA%.
SENTRYGATE_DATA_DIR=
SENTRYGATE_SESSION_SECRET=
# Production/pilot: PEM certificate and matching private key with SANs for both listener names.
SENTRYGATE_TLS_CERT=
SENTRYGATE_TLS_KEY=
# Maximum combined SQLite, WAL, and shared-memory bytes before event ingestion pauses.
SENTRYGATE_MAX_DB_BYTES=2147483648
# Warn in Settings and /api/health when database usage reaches this percentage of its cap.
SENTRYGATE_STORAGE_WARNING_PERCENT=80
# Warn when free space on the database volume drops below this number of bytes (0 disables this warning).
SENTRYGATE_MIN_FREE_DISK_BYTES=1073741824
SENTRYGATE_EVENT_INGEST_TIMEOUT_MS=1000
# Website-gateway durable local outbox limits used while the API is offline.
SENTRYGATE_GATEWAY_OUTBOX_MAX_BYTES=268435456
SENTRYGATE_GATEWAY_OUTBOX_MAX_EVENTS=100000
SENTRYGATE_GATEWAY_OUTBOX_RETRY_MS=5000
# For non-loopback deployments, use an HTTPS URL matching the certificate name.
SENTRYGATE_API_BASE_URL=
